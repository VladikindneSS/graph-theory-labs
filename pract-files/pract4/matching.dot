graph G {
  label="minimum perfect matching weight = 4";
  labelloc=t;
  node [shape=circle];
  0;
  1;
  2;
  3;
  4;
  5;
  0 -- 3 [label="4", color=gray];
  0 -- 4 [label="1", color=red, penwidth=3];
  0 -- 5 [label="2", color=gray];
  1 -- 3 [label="2", color=red, penwidth=3];
  1 -- 4 [label="5", color=gray];
  1 -- 5 [label="7", color=gray];
  2 -- 4 [label="3", color=gray];
  2 -- 5 [label="1", color=red, penwidth=3];
}
